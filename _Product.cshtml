@model CafeManagement.Models.Product
<style>
    :root {
        --primary-color: #2F4F4F;
        --background-color: #F8F9FA;
        --text-color: #212529;
        --accent-color: #D4A373;
        --hover-color: #3E6464;
    }

    .card-hover {
        transition: all .3s ease;
        border-radius: 16px;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15);
        }

    .product-img {
        height: 250px;
        object-fit: cover;
    }

    .price {
        color: var(--accent-color);
        font-size: 1.4rem;
        font-weight: 700;
    }

    .btn-coffee {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }

        .btn-coffee:hover {
            background-color: var(--hover-color);
            border-color: var(--hover-color);
            color: white;
        }

    .badge-coffee {
        background-color: rgba(212,163,115,.15);
        color: var(--accent-color);
        border: 1px solid var(--accent-color);
    }
</style>

<div class="col">

    <div class="card h-100 border-0 shadow-sm card-hover">

        <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                ? "/images/no-image.png"
                : Model.ImageUrl)"
             class="card-img-top product-img"
             alt="@Model.ProductName" />

        <div class="card-body d-flex flex-column">

            @if (Model.Category != null)
            {
                <span class="badge rounded-pill text-bg-warning mb-2">
                    @Model.Category.CategoryName
                </span>
            }

            <h5 class="card-title">
                @Model.ProductName
            </h5>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="card-text text-muted small">
                    @Model.Description
                </p>
            }

            <div class="mt-auto">

                <p class="price mb-3">
                    @Model.Price.ToString("N0")đ
                </p>

                <a asp-controller="Products"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-coffee w-100">
                    Xem chi tiết
                </a>

            </div>

        </div>

    </div>

</div>