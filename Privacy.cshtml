@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout1";
}


@{
    ViewData["Title"] = "Chính sách & Điều khoản";
}

<style>
    :root {
        --primary-color: #2F4F4F;
        --background-color: #F8F9FA;
        --text-color: #212529;
        --accent-color: #D4A373;
        --hover-color: #3E6464;
    }

    body {
        background-color: var(--background-color);
        color: var(--text-color);
    }

    .policy-hero {
        background: linear-gradient( rgba(47,79,79,.95), rgba(47,79,79,.95) );
        color: white;
        padding: 100px 0;
    }

    .text-primary-custom {
        color: var(--primary-color);
    }

    .btn-accent {
        background: var(--accent-color);
        color: white;
        border: none;
    }

        .btn-accent:hover {
            background: var(--hover-color);
            color: white;
        }

    .title-line {
        width: 80px;
        height: 4px;
        background: var(--accent-color);
        margin: 12px auto 0;
        border-radius: 30px;
    }

    .policy-card {
        border: none;
        border-left: 5px solid var(--accent-color);
        border-radius: 15px;
        transition: .3s;
    }

        .policy-card:hover {
            transform: translateY(-5px);
        }

    .contact-card {
        border: none;
        border-top: 4px solid var(--accent-color);
        border-radius: 15px;
        transition: .3s;
    }

        .contact-card:hover {
            transform: translateY(-5px);
        }

    .section-title {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .policy-card ul {
        margin-bottom: 0;
    }

    .policy-card li {
        margin-bottom: 10px;
    }

    
    {
        padding: 70px 20px;
    }

    .policy-hero h1 {
        font-size: 2.3rem;
    }

    }
</style>

<!-- HERO -->
<section class="policy-hero text-center">
    <div class="container">

        <h1 class="display-4 fw-bold">
            Chính Sách & Điều Khoản
        </h1>

        <p class="lead mt-3">
            Cam kết bảo vệ dữ liệu, đảm bảo quyền lợi và mang đến trải nghiệm
            sử dụng tốt nhất cho người dùng Hệ Thống Quản Lý Quán Cà Phê.
        </p>

    </div>
</section>

<div class="container py-5">

    <!-- Chính sách bảo mật -->
    <section class="mb-5">

        <h2 class="section-title text-center text-primary-custom">
            Chính Sách Bảo Mật
        </h2>

        <div class="title-line mb-4"></div>

        <div class="card shadow-sm policy-card">
            <div class="card-body p-4">

                <p>
                    Hệ Thống Quản Lý Quán Cà Phê cam kết bảo vệ thông tin
                    và dữ liệu của người dùng trong suốt quá trình sử dụng hệ thống.
                </p>

                <ul>
                    <li>Không chia sẻ thông tin người dùng cho bên thứ ba khi chưa có sự đồng ý.</li>
                    <li>Áp dụng các biện pháp bảo mật nhằm bảo vệ dữ liệu khỏi truy cập trái phép.</li>
                    <li>Chỉ sử dụng dữ liệu cho mục đích quản lý và vận hành hệ thống.</li>
                    <li>Tôn trọng quyền riêng tư và bảo mật thông tin người dùng.</li>
                </ul>

            </div>
        </div>

    </section>

    <!-- Điều khoản sử dụng -->
    <section class="mb-5">

        <h2 class="section-title text-center text-primary-custom">
            Điều Khoản Sử Dụng
        </h2>

        <div class="title-line mb-4"></div>

        <div class="card shadow-sm policy-card">
            <div class="card-body p-4">

                <ul>
                    <li>Sử dụng hệ thống đúng mục đích quản lý và vận hành quán cà phê.</li>
                    <li>Không thực hiện các hành vi gây ảnh hưởng đến hoạt động của hệ thống.</li>
                    <li>Không truy cập trái phép hoặc can thiệp vào dữ liệu của người dùng khác.</li>
                    <li>Không sử dụng hệ thống cho các hoạt động vi phạm pháp luật.</li>
                    <li>Tuân thủ các quy định và hướng dẫn sử dụng của hệ thống.</li>
                </ul>

            </div>
        </div>

    </section>

    <!-- Quyền và trách nhiệm -->
    <section class="mb-5">

        <h2 class="section-title text-center text-primary-custom">
            Quyền Và Trách Nhiệm Người Dùng
        </h2>

        <div class="title-line mb-4"></div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="card shadow-sm contact-card h-100">
                    <div class="card-body">

                        <h4 class="text-primary-custom mb-3">
                            Quyền Của Người Dùng
                        </h4>

                        <ul>
                            <li>Được truy cập các chức năng theo quyền được cấp.</li>
                            <li>Được xem và quản lý dữ liệu thuộc phạm vi sử dụng.</li>
                            <li>Được hỗ trợ trong quá trình sử dụng hệ thống.</li>
                            <li>Được bảo vệ thông tin cá nhân và dữ liệu kinh doanh.</li>
                        </ul>

                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm contact-card h-100">
                    <div class="card-body">

                        <h4 class="text-primary-custom mb-3">
                            Trách Nhiệm Người Dùng
                        </h4>

                        <ul>
                            <li>Bảo mật tài khoản và mật khẩu đăng nhập.</li>
                            <li>Cung cấp thông tin chính xác khi sử dụng hệ thống.</li>
                            <li>Chịu trách nhiệm với các hoạt động phát sinh từ tài khoản.</li>
                            <li>Không chia sẻ tài khoản cho người không có thẩm quyền.</li>
                        </ul>

                    </div>
                </div>
            </div>

        </div>

    </section>

    <!-- Liên hệ -->
    <section>

        <h2 class="section-title text-center text-primary-custom">
            Thông Tin Liên Hệ
        </h2>

        <div class="title-line mb-4"></div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card shadow-sm contact-card h-100">
                    <div class="card-body text-center">

                        <h5 class="text-primary-custom">
                            Email
                        </h5>

                        <p class="mb-0">
                            support@cafemanagement.com
                        </p>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm contact-card h-100">
                    <div class="card-body text-center">

                        <h5 class="text-primary-custom">
                            Hotline
                        </h5>

                        <p class="mb-0">
                            0123 456 789
                        </p>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm contact-card h-100">
                    <div class="card-body text-center">

                        <h5 class="text-primary-custom">
                            Địa Chỉ
                        </h5>

                        <p class="mb-0">
                            [Địa chỉ của bạn]
                        </p>

                    </div>
                </div>
            </div>

        </div>

    </section>

</div>
```
