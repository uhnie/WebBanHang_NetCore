@{
    ViewData["Title"] = "Menu";
    Layout = "_Layout1";
}
@model IEnumerable<CafeManagement.Models.Product>

@{
    var categories = ViewBag.Categories;
    var selectedCategory = ViewBag.SelectedCategory;
}

<div class="container py-4">

    <h2 class="text-center mb-4">
         Thực Đơn
    </h2>

    <!-- DANH MỤC -->

    <div class="mb-4">

        <a asp-action="Menu"
           class="btn @(selectedCategory == null ? "btn-dark" : "btn-outline-dark") me-2 mb-2">
            Tất cả
        </a>

        @foreach (var category in categories)
        {
            <a asp-action="Menu"
               asp-route-categoryId="@category.Id"
               class="btn @(selectedCategory == category.Id ? "btn-primary" : "btn-outline-primary") me-2 mb-2">

                @category.CategoryName

            </a>
        }

    </div>

    <!-- SẢN PHẨM -->

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

        @foreach (var item in Model)
        {
            <partial name="_Product" model="item" />
        }

    </div>

</div>