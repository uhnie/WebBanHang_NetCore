@{
    ViewData["Title"] = "Pos";
    Layout = "_Layout2";
}
@using CafeManagement.Models

@{
    var tables = ViewBag.Tables as List<CafeTable>;
    var products = ViewBag.Products as List<Product>;
    var cart = ViewBag.Cart as List<CartItem>;
}

<style>
    :root {
        --primary-color: #2F4F4F;
        --background-color: #F8F9FA;
        --text-color: #212529;
        --accent-color: #D4A373;
        --hover-color: #3E6464;
    }

    body {
        background: var(--background-color);
    }

    .coffee-header {
        background: linear-gradient(135deg, var(--primary-color), var(--hover-color));
        color: white;
        padding: 18px 24px;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.12);
    }

    .section-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
        height: 100%;
    }

    .section-title {
        color: var(--primary-color);
        font-weight: 700;
        border-left: 5px solid var(--accent-color);
        padding-left: 12px;
        margin-bottom: 20px;
    }

    .table-btn {
        border-radius: 12px;
        padding: 12px;
        transition: .25s;
        font-weight: 600;
    }

        .table-btn:hover {
            transform: translateY(-2px);
        }

    .btn-primary {
        background: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-primary:hover {
            background: var(--hover-color);
            border-color: var(--hover-color);
        }

    .btn-success {
        background: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-success:hover {
            background: var(--hover-color);
            border-color: var(--hover-color);
        }

    .btn-warning {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: white;
    }

        .btn-warning:hover {
            color: white;
            opacity: .9;
        }

    .product-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        transition: .25s;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0,0,0,.15);
        }

    .product-name {
        color: var(--primary-color);
        font-weight: 700;
    }

    .product-price {
        color: var(--accent-color);
        font-size: 18px;
        font-weight: bold;
    }

    .table thead {
        background: var(--primary-color);
        color: white;
    }

    .cart-total {
        background: rgba(212,163,115,.15);
        border: 1px solid var(--accent-color);
        border-radius: 12px;
        padding: 15px;
    }

        .cart-total h4 {
            margin: 0;
            color: var(--primary-color);
            font-weight: bold;
        }

    .empty-cart {
        border-radius: 12px;
    }
</style>

<div class="container-fluid py-3">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            @TempData["Success"]
        </div>
    }

    <div class="coffee-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">☕ Quản lý bán hàng Cafe</h2>

        <a asp-controller="Reservation"
           asp-action="Index"
           class="btn btn-warning">
            Đặt bàn
        </a>
    </div>

    <div class="row g-4">

        <!-- DANH SÁCH BÀN -->
        <div class="col-lg-3">
            <div class="section-card">

                <h4 class="section-title">
                    Danh sách bàn
                </h4>

                @foreach (var table in tables)
                {
                    string btnClass = "btn-success";

                    if (table.Status == "Đang sử dụng")
                    {
                        btnClass = "btn-danger";
                    }

                    <a asp-action="Index"
                       asp-route-tableId="@table.Id"
                       class="btn @btnClass table-btn w-100 mb-3">

                        @table.TableName
                        <br />
                        <small>
                            @(table.Status == "Đang sử dụng"
                                ? "Đang sử dụng"
                                : "Trống")
                        </small>

                    </a>
                }

            </div>
        </div>

        <!-- MENU -->
        <div class="col-lg-5">
            <div class="section-card">

                <h4 class="section-title">
                    Menu
                </h4>

                <div class="row">

                    @foreach (var item in products)
                    {
                        <div class="col-md-6">

                            <div class="card product-card mb-3">

                                <div class="card-body">

                                    <h5 class="product-name">
                                        @item.ProductName
                                    </h5>

                                    <p class="product-price">
                                        @item.Price.ToString("N0") VNĐ
                                    </p>

                                    @if (ViewBag.SelectedTable != null)
                                    {
                                        <form asp-action="AddToCart"
                                              method="post">

                                            <input type="hidden"
                                                   name="tableId"
                                                   value="@ViewBag.SelectedTable" />

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.Id" />

                                            <button class="btn btn-success w-100">
                                                Thêm món
                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>
        </div>

        <!-- GIỎ HÀNG -->
        <div class="col-lg-4">
            <div class="section-card">

                <h4 class="section-title">
                    Bàn: @ViewBag.SelectedTable
                </h4>

                @if (cart != null && cart.Any())
                {
                    <table class="table table-bordered align-middle">

                        <thead>
                            <tr>
                                <th>Món</th>
                                <th>SL</th>
                                <th>Tiền</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in cart)
                            {
                                <tr>

                                    <td>@item.ProductName</td>

                                    <td>@item.Quantity</td>

                                    <td>
                                        @((item.Price * item.Quantity).ToString("N0"))
                                    </td>

                                    <td>

                                        <form asp-action="RemoveItem"
                                              method="post">

                                            <input type="hidden"
                                                   name="tableId"
                                                   value="@ViewBag.SelectedTable" />

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.ProductId" />

                                            <button class="btn btn-sm btn-danger">
                                                X
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                    <div class="cart-total mb-3">
                        <h4>
                            Tổng tiền:
                            @(cart.Sum(x => x.Price * x.Quantity).ToString("N0")) VNĐ
                        </h4>
                    </div>

                    <form asp-action="TempInvoice"
                          method="get">

                        <input type="hidden"
                               name="tableId"
                               value="@ViewBag.SelectedTable" />

                        <button class="btn btn-warning w-100 mb-2">
                            🖨 In tạm tính
                        </button>

                    </form>

                    <form asp-action="Checkout"
                          method="post"
                          onsubmit="return confirm('Xác nhận thanh toán?');">

                        <input type="hidden"
                               name="tableId"
                               value="@ViewBag.SelectedTable" />

                        <button type="submit"
                                class="btn btn-danger w-100 py-3 fw-bold shadow">
                            💰 Thanh toán
                        </button>

                    </form>
                }
                else
                {
                    <div class="alert alert-secondary empty-cart">
                        Chưa có món nào được chọn
                    </div>
                }

            </div>
        </div>

    </div>

</div>