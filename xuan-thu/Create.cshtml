@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout2";
}
@model CafeManagement.Models.Reservation

@{
    ViewData["Title"] = "Đặt bàn";
}

<style>
    :root {
        --primary-color: #2F4F4F;
        --background-color: #F8F9FA;
        --text-color: #212529;
        --accent-color: #D4A373;
        --hover-color: #3E6464;
    }

    body {
        background-color: var(--background-color);
    }

    .page-title {
        color: var(--primary-color);
        font-weight: 700;
    }

    .reservation-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .reservation-header {
        background: linear-gradient( 135deg, var(--primary-color), var(--hover-color) );
        color: white;
        padding: 20px;
    }

        .reservation-header h3 {
            margin: 0;
            font-weight: 700;
        }

    .card-body {
        padding: 30px;
    }

    .form-label {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #dcdcdc;
        transition: all .3s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 .2rem rgba(212,163,115,.25);
        }

    .btn-save {
        background: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 600;
    }

        .btn-save:hover {
            background: var(--hover-color);
            border-color: var(--hover-color);
            color: white;
        }

    .btn-back {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: white;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 600;
    }

        .btn-back:hover {
            color: white;
            opacity: .9;
        }

    .form-section {
        background: white;
        border-radius: 20px;
    }

    .text-danger {
        font-size: .9rem;
    }

    .coffee-badge {
        display: inline-block;
        background: rgba(212,163,115,.15);
        color: var(--accent-color);
        padding: 8px 16px;
        border-radius: 30px;
        font-weight: 600;
        margin-bottom: 10px;
    }
</style>

<div class="container py-5">

    <div class="text-center mb-4">

        <div class="coffee-badge">
            ☕ Cafe Management
        </div>

        <h2 class="page-title">
            Đặt bàn khách hàng
        </h2>

        <p class="text-muted">
            Tạo thông tin đặt bàn trước cho khách
        </p>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card reservation-card">

                <div class="reservation-header">
                    <h3>
                        📅 Thông tin đặt bàn
                    </h3>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="CustomerName"
                                   class="form-label">
                                Tên khách hàng
                            </label>

                            <input asp-for="CustomerName"
                                   class="form-control"
                                   placeholder="Nhập tên khách hàng" />

                            <span asp-validation-for="CustomerName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                                Số điện thoại
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Nhập số điện thoại" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="TableId"
                                   class="form-label">
                                Chọn bàn
                            </label>

                            <select asp-for="TableId"
                                    class="form-select">

                                <option value="">
                                    -- Chọn bàn --
                                </option>

                                @foreach (var item in ViewBag.Tables)
                                {
                                    <option value="@item.Id">
                                        @item.TableName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ReservationTime"
                                   class="form-label">
                                Thời gian đặt
                            </label>

                            <input asp-for="ReservationTime"
                                   type="datetime-local"
                                   class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />

                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">

                            <a asp-action="Index"
                               class="btn btn-back">
                                ← Quay lại
                            </a>

                            <button type="submit"
                                    class="btn btn-save">
                                💾 Lưu đặt bàn
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}