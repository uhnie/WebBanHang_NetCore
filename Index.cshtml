@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout1";
}

<style>
    :root {
        --primary-color: #2F4F4F;
        --background-color: #F8F9FA;
        --text-color: #212529;
        --accent-color: #D4A373;
        --hover-color: #3E6464;
    }

    body {
        background-color: var(--background-color);
        color: var(--text-color);
    }

    .section {
        padding: 80px 0;
    }

    .section-title {
        color: var(--primary-color);
        font-weight: 700;
        text-align: center;
        margin-bottom: 15px;
    }

        .section-title::after {
            content: "";
            display: block;
            width: 80px;
            height: 4px;
            background: var(--accent-color);
            margin: 12px auto 0;
            border-radius: 50px;
        }

    .custom-card {
        border: none;
        border-left: 5px solid var(--accent-color);
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,.05);
    }

    .feature-card {
        border: none;
        border-top: 4px solid var(--accent-color);
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,.05);
        transition: all .3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
        }

    .contact-card {
        border: none;
        border-left: 4px solid var(--accent-color);
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,.05);
        transition: all .3s ease;
    }

        .contact-card:hover {
            transform: translateY(-5px);
        }

        .contact-card h5 {
            color: var(--primary-color);
            font-weight: 700;
        }

    .hero-overlay {
        background: rgba(47,79,79,.55);
    }

    .hero-btn {
        background-color: var(--accent-color);
        border: none;
        color: white;
        font-weight: 600;
        padding: 12px 30px;
    }

        .hero-btn:hover {
            background-color: var(--hover-color);
            color: white;
        }
</style>

<!-- HERO -->
<div class="position-relative">

    <img src="~/Anh/thiet-ke-nha-hang-chay-2030.jpg"
         class="w-100"
         style="height: calc(100vh - 70px); object-fit: cover;"
         alt="Cafe" />

    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>

    <div class="position-absolute top-50 start-50 translate-middle text-center text-white">

        <h1 class="display-1 fw-bold">CAFE MANAGEMENT</h1>

        <p class="fs-3">
            Hệ thống quản lý quán cà phê chuyên nghiệp
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-lg hero-btn mt-3">
            Bắt đầu ngay
        </a>

    </div>

</div>

<!-- GIỚI THIỆU -->
<section class="section">
    <div class="container">

        <h2 class="section-title">Giới Thiệu</h2>

        <div class="card custom-card">
            <div class="card-body p-4">

                <p>
                    Chào mừng bạn đến với <strong>Hệ Thống Quản Lý Quán Cà Phê</strong> –
                    giải pháp hỗ trợ quản lý và vận hành quán cà phê một cách hiệu quả,
                    hiện đại và chuyên nghiệp.
                </p>

                <p>
                    Được phát triển nhằm đáp ứng nhu cầu quản lý ngày càng cao trong lĩnh vực
                    kinh doanh đồ uống, hệ thống giúp chủ quán dễ dàng kiểm soát mọi hoạt động
                    từ bán hàng, quản lý thực đơn, hóa đơn, nhân viên đến theo dõi doanh thu
                    và thống kê hoạt động kinh doanh.
                </p>

            </div>
        </div>

    </div>
</section>

<!-- SỨ MỆNH -->
<section class="section bg-white">
    <div class="container">

        <h2 class="section-title">Sứ Mệnh</h2>

        <div class="card custom-card">
            <div class="card-body p-4">

                Chúng tôi mong muốn mang đến một nền tảng quản lý đơn giản,
                trực quan và dễ sử dụng, giúp các quán cà phê tối ưu quy trình
                vận hành, tiết kiệm thời gian và nâng cao chất lượng phục vụ khách hàng.

            </div>
        </div>

    </div>
</section>

